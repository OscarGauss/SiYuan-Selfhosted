{
  "name": "siyuan-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for SiYuan note-taking app",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "siyuan-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx --yes @modelcontextprotocol/inspector node --env-file=.env.local dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
