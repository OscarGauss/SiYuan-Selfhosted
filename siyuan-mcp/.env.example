# Base URL of your SiYuan instance (no trailing slash).
# Examples:
#   https://notes.example.com
#   http://siyuan:6806    (when running inside the same Docker network)
SIYUAN_BASE_URL=http://127.0.0.1:6806

# API token from SiYuan: Settings → About → API token
SIYUAN_API_TOKEN=

# Transport: "stdio" (default, for Claude Desktop) or "http" (for remote deploys).
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=http
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=0.0.0.0

# Optional bearer token clients must send when MCP_TRANSPORT=http.
# Leave empty to disable auth (only safe behind a private network).
MCP_HTTP_AUTH_TOKEN=
